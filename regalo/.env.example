# Copia este archivo como .env (local) o pon estas variables en Vercel → Settings → Environment Variables.
# Sin ninguna clave, la tienda funciona en modo demo: pedidos y pagos simulados.

# Rye: compra automática en la tienda de origen (console.rye.com). Empieza con staging.
RYE_API_KEY=
RYE_ENTORNO=staging

# Stripe: cobro dentro de la página (dashboard.stripe.com → Developers → API keys).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook con el evento payment_intent.succeeded apuntando a https://TU-DOMINIO/api/webhook-stripe
STRIPE_WEBHOOK_SECRET=

# Margen de Acierto sobre el total de la tienda. Debe cubrir la comisión de Stripe (~2,9 % + 0,30 USD).
MARGEN_PORCENTAJE=15
MARGEN_FIJO_CENTAVOS=100
